POSTGRES_DB=lead_radar
POSTGRES_USER=lead_radar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://lead_radar:change-me@postgres:5432/lead_radar
ENVIRONMENT=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=change-me
# Prefer an Argon2 hash in production; when set it takes precedence over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
AUTH_TOKEN_TTL_HOURS=12
# Set true behind HTTPS, false only for local HTTP/IP testing.
SECURE_COOKIES=false
APP_TIMEZONE=Europe/Moscow
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_DIR=/app/data/sessions
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATION_CHAT_ID=
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
LEAD_SCORE_THRESHOLD=70
VITE_API_URL=http://localhost:8000
# Production installer sets a domain or http://IP for Caddy.
SITE_ADDRESS=http://localhost
